# ==============================================================================
# Tier 1 - Debian 13 Server (n8n + 24/7 CPU Ollama)
# ==============================================================================
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://192.168.1.XXX:5678
GENERIC_TIMEZONE=Europe/Paris

OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=24h

# ==============================================================================
# IMAP Configuration (Automated Folder Routing)
# ==============================================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=thom1.lableigne@gmail.com
IMAP_PASSWORD=YOUR_IMAP_APP_PASSWORD

# ==============================================================================
# Discord Alerts (Native n8n Webhook)
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ==============================================================================
# Tier 2 - Arch Linux Workstation (Wake-on-LAN, Windows 11 Dual-Boot & SSH)
# ==============================================================================
ARCH_MAC_ADDRESS=XX:XX:XX:XX:XX:XX
ARCH_IP=192.168.1.XXX
ARCH_OLLAMA_PORT=11434
ARCH_SSH_USER=archuser
ARCH_SSH_PORT=22
ARCH_SSH_KEY=/root/.ssh/id_ed25519_wol
WOL_INTERFACE=enp9s0
WOL_TIMEOUT_SEC=90
DUALBOOT_GRACE_SEC=25
